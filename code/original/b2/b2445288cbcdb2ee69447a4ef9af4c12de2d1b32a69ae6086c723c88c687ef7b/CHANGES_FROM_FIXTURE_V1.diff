+# PREPARED ONLY. Six unchanged LM loaders + readonly storage; NO search, score, or input.
+use strict;use warnings;
+use Config;use JSON::PP;use Time::HiRes qw(time);
+use ReadLM;use NoSpace;use CompactPatList;
+BEGIN {die 'RUNTIME' unless "$^V" eq 'v5.38.2' && $Config{archname} eq 'x86_64-linux-gnu-thread-multi';}
+$|=1;
+die 'ARGS' unless @ARGV==3;
+my ($base,$read_fd,$write_fd)=@ARGV;
+my $json=JSON::PP->new->ascii(1)->canonical(1);
+open my $fh,'<',"$base/FREEZE.json" or die $!;
+my $freeze=$json->decode(do{local $/;<$fh>});close $fh or die $!;
+my $t=time();
+sub emit {print $json->encode([@_]),"\n" or die $!;}
+sub snapshot {
+  my ($phase)=@_;open my $p,'<','/proc/self/status' or die $!;
+  my @memory=grep {/^(?:VmPeak|VmSize|VmHWM|VmRSS):/} <$p>;
+  close $p or die $!;chomp @memory;emit('profile',$phase,time()-$t,\@memory);
+}
+my @models=({},{},{},{},{},{}); # all six remain live together until process exit
+snapshot('before_six_LM');
+for my $i (0..5) {
+  my $item=$freeze->{six_lm}[$i];emit('load_begin',$i+1,$item->{path});
+  if ($i==0 || $i==3) {ReadLM::ReadUnigramLM($item->{path},$models[$i]);}
+  elsif ($i==1 || $i==4) {ReadLM::ReadBigramLM($item->{path},$models[$i]);}
+  else {ReadLM::ReadTrigramLM($item->{path},$models[$i]);}
+  snapshot('after_LM_'.($i+1));
+}
+my ($bridge,$groups,$words,$maxlen)=CompactPatList->attach($read_fd,$write_fd);
+die 'MAXLEN' unless $maxlen==46;snapshot('readonly_storage_attached');
+for my $pattern ('a','aa','ab','aba','abc','abcdefgh','!','abcdefgh') {
+  my $values=$groups->[1]{$pattern};emit('list',$pattern,$values);snapshot('lookup_'.$pattern);
+}
+for my $str ('to','togo','xxyyzz','catdog',''," \t ") {
+  emit('segment',$str,NoSpace::FindWords($str,$words,$maxlen));
+}
+snapshot('all_six_retained_after_storage_probes');
+$bridge->close();emit('complete',{lm_loads=>6,list_fetches=>8,segmentations=>6,search_calls=>0,score_calls=>0,input_bytes=>0});
