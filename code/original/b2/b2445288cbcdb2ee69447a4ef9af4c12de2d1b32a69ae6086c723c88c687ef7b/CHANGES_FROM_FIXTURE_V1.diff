+# PREPARED ONLY. Finite transport contract; no solver/scorer or numerical models.
+use strict;use warnings;
+use JSON::PP;use Config;use CompactPatList;
+BEGIN {die 'RUNTIME' unless "$^V" eq 'v5.38.2' && $Config{archname} eq 'x86_64-linux-gnu-thread-multi';}
+$|=1;
+die 'ARGS' unless @ARGV==3;
+my ($base,$read_fd,$write_fd)=@ARGV;
+my $json=JSON::PP->new->ascii(1)->canonical(1);
+sub emit {print $json->encode([@_]),"\n" or die $!;}
+open my $input,'<',"$base/negative/index.json" or die $!;
+my $tests=$json->decode(do{local $/;<$input>});close $input or die $!;
+for my $test (@$tests) {
+  open my $rd,'<',"$base/negative/$test->{file}" or die $!;binmode $rd;
+  my $client=bless {rd=>$rd,buffer=>'',json=>$json},'CompactPatList';
+  my $ok=eval {$client->_response(1,'list');1};my $error=$@;
+  close $rd or die $!;
+  die "NEGATIVE_ACCEPTED:$test->{name}" if $ok;
+  die "WRONG_REJECTION:$test->{name}:$error" unless index($error,$test->{error_prefix})==0;
+  emit('negative',$test->{name},$test->{error_prefix});
+}
+open my $rd,'<',"$base/negative/positive_chunks.jsonl" or die $!;binmode $rd;
+my $client=bless {rd=>$rd,buffer=>'',json=>$json},'CompactPatList';
+my $positive=$client->_response(1,'list');close $rd or die $!;
+die 'POSITIVE_CHUNKS' unless $json->encode($positive) eq '["aa","aa","bb"]';
+emit('positive_chunks',$positive);
+my ($bridge,$groups,$words,$maxlen)=CompactPatList->attach($read_fd,$write_fd);
+die 'MAXLEN' unless $maxlen==46;
+for my $pattern ('a','aa','ab','aba','abc','abcdefgh','!','abcdefgh') {
+  my $values=$groups->[1]{$pattern};emit('list',$pattern,$values);
+  $values->[0]='MUTATED_CALLER_COPY' if defined($values) && $pattern eq 'abcdefgh';
+}
+$bridge->close();emit('complete',{list_fetches=>8,negative=>10,positive_chunks=>1});
